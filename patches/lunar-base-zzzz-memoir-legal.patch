+# and 9 in all (the four first rolls and the raises at +3, +6, +9, +12 and +15).
+LEGAL_SUB_KEYS: Final[dict[str, str]] = {"crit_rate": "crit_rate", "crit_dmg": "crit_damage", "atk_pct": "attack_pct",
+                                         "hp_pct": "hp_pct", "def_pct": "defense_pct", "agility": "agility"}
+LEGAL_SUB_ORDER: Final[list[str]] = ["crit_rate", "crit_dmg", "atk_pct", "hp_pct"]
+LEGAL_DEFAULTS: Final[dict[str, int]] = {"crit_rate": 250, "crit_dmg": 60, "atk_pct": 50, "hp_pct": 25,
+                                         "def_pct": 25, "agility": 12}     # crit rate at its top, then the rest: 9 rolls
+
+
+LEGAL_PRIMARY_DEFAULTS: Final[list[str]] = ["atk_pct", "crit_rate", "atk_pct"]   # only the second memoir mains crit
+
+
+def check_legal_main(primary_key: str, index: int) -> None:
+    """Raise MemoirError unless the set's memoir at this place (0, 1, 2) can main this stat in the original game:
+    the first mains ATK, DEF or HP; the second may also main crit; the third may also main agility."""
+    from deckbuilder import raise_
+    if not raise_.main_allowed(LEGAL_SUB_KEYS.get(primary_key, ""), index):
+        raise MemoirError(f"{PRIMARY_BY_KEY[primary_key]['label']} can't be the main of memoir {index + 1} of a set "
+                          "(the second memoir may main crit, the third agility, the first only ATK, DEF or HP)")
+
+
+def check_legal(subs: list[dict]) -> None:
+    """Raise MemoirError unless the original game could have made these sub stats (resolved values)."""
+    from deckbuilder import raise_
+    rolls, seen = 0, set()
+    for s in subs:
+        key = s["sub_key"]
+        name = LEGAL_SUB_KEYS.get(key)
+        if name is None:
+            raise MemoirError(f"{SUB_BY_KEY[key]['label']}: the original game has no flat sub stat")
+        if key in seen:
+            raise MemoirError(f"{SUB_BY_KEY[key]['label']} twice: a memoir has each sub stat once")
+        seen.add(key)
+        value = int(s["value"])
+        if value < 1 or value > raise_.SUB_TOP[name]:
+            raise MemoirError(f"{SUB_BY_KEY[key]['label']}: {value} is past its top of {raise_.SUB_TOP[name]}")
+        n = -(-value // raise_.SUB_ROLL[name])
+        if n > raise_.MAX_ROLLS_PER_SUB:
+            raise MemoirError(f"{SUB_BY_KEY[key]['label']}: {n} rolls, at most {raise_.MAX_ROLLS_PER_SUB} on one sub stat")
+        rolls += n
+    if rolls > raise_.MAX_ROLLS:
+        raise MemoirError(f"{rolls} rolls in all: a memoir gets at most {raise_.MAX_ROLLS} (no more than one sub stat at its top)")
+
+
+def _build_subs_for_shim(subs: list[dict], legal: bool = False) -> list[dict]:
