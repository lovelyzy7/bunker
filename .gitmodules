[submodule "upstream/lunar-tear"]
	path = upstream/lunar-tear
	url = https://github.com/lovelyzy7/lunar-tear.git
[submodule "upstream/lunar-base"]
	path = upstream/lunar-base
	url = https://github.com/lovelyzy7/lunar-base.git
[submodule "upstream/lunar-tear-masterdata-patcher"]
	path = upstream/lunar-tear-masterdata-patcher
	url = https://github.com/NavHobbyDev/lunar-tear-masterdata-patcher.git
	# The builders load its patcher, which leaves __pycache__ behind.
	ignore = untracked
[submodule "upstream/bunker-modmenu"]
	path = upstream/bunker-modmenu
	url = https://github.com/lovelyzy7/bunker-modmenu.git
	# Mod Menu 源仓（JP/EN 双 workspace：modmenu 安卓工程 + jni 原生源）。
	# web/modmenu/ payload 由 scripts/make_menu_payload.py 从本仓重建；
	# android/tools/menu.py 的查找序：--mod-menu-root > $BUNKER_MODMENU >
	# vendor/bunker-modmenu > upstream/bunker-modmenu（本钉）。
[submodule "upstream/lunar-scripts-zh"]
	path = upstream/lunar-scripts-zh
	url = https://github.com/lovelyzy7/lunar-scripts-zh.git
	# 中文脚本仓（JP/EN 汉化调用面）。由目录联接登记（upstream-local）转正为
	# submodule：gitlink = commit pin；upstream.lock.json 保留契约摘要 pin，
	# 双钉皆由 prepare.py 预检（commit + digest）。
	# 纪律不变：禁止 git submodule update --remote；更新走 fetch/checkout <commit> +
	# bump lock + MANIFEST 重生成 + 冒烟。
	# Windows 本地开发位可用目录联接指向仓库外本地检出，联接目标 HEAD 须等于
	# gitlink pin 方可过 prepare 预检。
	# 旧 upstream/lunar-scripts 与 upstream/lunar-scripts-jp 已移除（调用面并入本仓）。
